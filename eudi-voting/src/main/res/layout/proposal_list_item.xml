<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/proposalsList"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/proposalDescriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proposal Description"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/proposalDetailsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proposal Details"
        android:textSize="12sp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/proposalDeadlineTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Deadline: 2024-07-27" />

        <TextView
            android:id="@+id/proposalVotesTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Votes: 100" />
    </LinearLayout>
</LinearLayout>